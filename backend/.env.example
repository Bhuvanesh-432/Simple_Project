# Backend environment variables (DO NOT commit this file)
NODE_ENV=production
PORT=5000

# Database (AWS RDS PostgreSQL)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=simpledb
DB_USER=postgres
DB_PASSWORD=YourSecurePassword123!
DB_SSL=true

# Frontend URL for CORS
FRONTEND_URL=http://your-frontend-alb-url.amazonaws.com
